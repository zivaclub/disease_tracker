# DiseaseWatch v2 — Production Environment

# PostgreSQL (default for docker-compose)
DATABASE_URL=postgresql+asyncpg://diseasewatch:diseasewatch@localhost:5432/diseasewatch

# Redis (Celery + cache)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-use-openssl-rand-hex-32
ENVIRONMENT=development

# AI (optional — falls back to high-quality mock responses)
GEMINI_API_KEY=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Frontend dev proxy target
VITE_API_PROXY=http://localhost:8000
